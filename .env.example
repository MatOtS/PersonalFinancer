# Copy to .env.local. Supabase values come from `npm run db:start` (local) or the
# Supabase dashboard (production). Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, e2e tests only: path of an installed Chromium-based browser,
# so Playwright does not download its own. Leave empty to use Playwright's.
PLAYWRIGHT_BROWSER_PATH=
